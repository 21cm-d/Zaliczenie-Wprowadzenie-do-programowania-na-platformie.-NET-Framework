<Window x:Class="BazaProduktowWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Baza produktów" Height="560" Width="850"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1"
                Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Nazwa:" VerticalAlignment="Center"/>
                <TextBox x:Name="txtNazwa" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Kategoria:" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox x:Name="txtKategoria" Grid.Column="3" Margin="5"/>

                <TextBlock Text="Cena:" Grid.Row="1" VerticalAlignment="Center"/>
                <TextBox x:Name="txtCena" Grid.Row="1" Grid.Column="1" Margin="5"/>

                <TextBlock Text="Ilość:" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center"/>
                <TextBox x:Name="txtIlosc" Grid.Row="1" Grid.Column="3" Margin="5"/>

                <StackPanel Grid.Row="2" Grid.ColumnSpan="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0">
                    <Button Content="Dodaj" Width="100" Margin="5"
                            Click="Dodaj_Click"/>
                    <Button Content="Edytuj" Width="100" Margin="5"
                            Click="Edytuj_Click"/>
                    <Button Content="Usuń" Width="100" Margin="5"
                            Click="Usun_Click"/>
                    <Button Content="Wyczyść" Width="100" Margin="5"
                            Click="Wyczysc_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Szukaj:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="txtSzukaj" Width="300"
                     TextChanged="Szukaj_TextChanged"/>
        </StackPanel>

        <DataGrid x:Name="tabelaProduktow"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  SelectionChanged="TabelaProduktow_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="*"/>
                <DataGridTextColumn Header="Kategoria" Binding="{Binding Kategoria}" Width="*"/>
                <DataGridTextColumn Header="Cena" Binding="{Binding Cena}" Width="120"/>
                <DataGridTextColumn Header="Ilość" Binding="{Binding Ilosc}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
